[Unit]
Description=SAG · seguimiento de alumnos
After=network.target

[Service]
Type=simple
User=sag
Group=sag
WorkingDirectory=/opt/sag
EnvironmentFile=/etc/sag.env
ExecStart=/usr/bin/node --experimental-sqlite --import tsx server/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
