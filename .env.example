# Copia estos valores como variables de entorno de tu terminal o servicio.
# Los scripts no cargan .env automaticamente; para Node puedes usar --env-file.
PORT=3001
SAG_HOST=127.0.0.1
SAG_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
SAG_SECURE_COOKIE=0
# En alojamiento HTTPS: SAG_ORIGINS=https://sag.tu-institucion.edu
# y SAG_SECURE_COOKIE=1. Nunca activar SAG_DEMO en un servidor accesible.
